node_modules/

# Credentials — never commit these.
.env
.env.local

# Persistent state: your sync log (workout names + timestamps), movement cache,
# and Garmin tokens. The token store is equivalent to a logged-in session.
data/

# Generated / personal exports.
*.fit
*.log
tonal-movements.json
.cache/

# TLS certs/keys (e.g. Tailscale Funnel) — never commit these.
*.crt
*.key

# Scratch/local-only scripts.
scripts/scratch/
scripts/scratch-check.mjs
