# Copy this file to `.env` and fill it in:  cp .env.example .env
#
# .env holds credentials in plaintext. It is gitignored — keep it that way, and
# restrict it:  chmod 600 .env
# See SECURITY.md.

# ---------------------------------------------------------------------------
# Tonal  (required)
# ---------------------------------------------------------------------------
# Your normal Tonal account login. Tonal has no public API and no OAuth, so the
# service signs in the same way the mobile app does. If you sign in to Tonal with
# Google or Apple, set an email + password on the account first.
# See docs/tonal-access.md.
TONAL_EMAIL=you@example.com
TONAL_PASSWORD=your-tonal-password

# ---------------------------------------------------------------------------
# Garmin Connect  (required, but not a password)
# ---------------------------------------------------------------------------
# There is no Garmin password here on purpose. Garmin's WAF and MFA make headless
# password login impossible, so you log in once interactively and the service
# reuses the resulting tokens:
#
#   npm run bootstrap:garmin
#
# That writes $DATA_DIR/garmin-tokens/. See docs/garmin-access.md.
# GARMIN_EMAIL is informational only — the service never uses it to log in.
GARMIN_EMAIL=you@example.com

# ---------------------------------------------------------------------------
# Webhook security  (required)
# ---------------------------------------------------------------------------
# Shared secret Home Assistant must send in the `x-webhook-secret` header.
# Generate a long random one — don't invent one by hand:
#   openssl rand -hex 32
WEBHOOK_SECRET=change-me-run-openssl-rand-hex-32

# ---------------------------------------------------------------------------
# Automatic sync checks  (optional)
# ---------------------------------------------------------------------------
# Minutes between polls for new workouts. 0 = off (webhook only).
#
# REQUIRED ON IPHONE: iOS does not let any app read another app's notifications,
# so the Home Assistant notification trigger is Android-only and polling is the
# only automatic option. 20 is a good starting point.
#
# On Android, a slow backstop poll (e.g. 360 = 6 hours) alongside the
# notification trigger catches missed notifications, reboots and HA downtime.
#
# Minimum accepted value is 15; lower values are clamped with a warning. Tonal's
# API is unofficial — polling harder risks it being blocked for everyone.
# See docs/iphone.md.
POLL_INTERVAL_MINUTES=0

# How many recent activities each poll examines. 3 covers back-to-back workouts
# and anything missed while the service was down. Already-synced ones are skipped.
POLL_LOOKBACK=3

# ---------------------------------------------------------------------------
# Service config  (optional — the defaults are fine)
# ---------------------------------------------------------------------------
# Port INSIDE the container. Leave this alone; to change the port you connect to,
# set HOST_PORT below instead.
PORT=8080

# Port published on the host — this is what Home Assistant points at.
# Change it if 8090 is already taken on your machine.
HOST_PORT=8090

# Persistent state: sync log, movement cache, Garmin tokens.
# /data is correct for Docker. Running outside Docker, use ./data.
DATA_DIR=/data

# Timezone for log timestamps only. FIT files always use absolute UTC times, so
# this cannot shift when your workouts appear in Garmin. e.g. America/New_York
TZ=UTC

# ---------------------------------------------------------------------------
# Units  (optional)
# ---------------------------------------------------------------------------
# The unit Tonal reports loads in. Tonal reports pounds; only change this if
# `npm run verify` shows otherwise.
TONAL_WEIGHT_UNIT=lb

# How Garmin Connect should DISPLAY loads: kg or lb. Weights are always stored in
# kilograms (the FIT spec requires it) — this only changes what you see.
GARMIN_DISPLAY_UNIT=kg
